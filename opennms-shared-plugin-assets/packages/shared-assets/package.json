{
  "name": "@onms-lab/shared-assets",
  "version": "1.0.0",
  "private": true,
  "description": "Helper that every OpenNMS UI plugin uses to reference the shared assets Jetty serves at /opennms/assets/shared/.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "22.20.4",
    "typescript": "5.4.5",
    "vitest": "2.1.9"
  }
}
